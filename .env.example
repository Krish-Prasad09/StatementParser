# Environment Configuration Template for Activv Money PMS/AIF Parser
# Copy this file to .env and configure your keys if you wish to run live IMAP or live LLM learning.

# 1. LLM One-Shot Template Learner (Used by learn_demo.py and pipeline.py on unseen formats)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BACKUP_API_KEY=your_backup_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gemini-3.8-flash

# 2. Live IMAP Mailbox Poller (Used by watch_mailbox.py and app.py for live email ingestion)
# Note: For Gmail, use a 16-character Google App Password (not your personal account password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password_here
IMAP_FOLDER=INBOX

# 3. Encrypted PDF Candidate Passwords (Optional comma-separated passwords)
# STATEMENT_PASSWORDS=SecretPass123,ANANYA1985

# 4. Cloud Database Persistence (Optional: Neon PostgreSQL connection string)
# If omitted, defaults automatically to zero-config local SQLite (statements.db)
# DATABASE_URL=postgresql://user:pass@ep-cool-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
