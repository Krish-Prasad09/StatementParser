    "regex": "^\\s*(\\d+)\\s+(.+?)\\s+([A-Z0-9]{12})\\s+([0-9,.]+)\\s+([0-9,.]+)\\s+([0-9,.]+)\\s+([0-9,.]+)\\s+([0-9,.]+)",
